<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="ltr"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_card_dark">

    <!-- Section 1: Top Bar [Left: City Name + Pin] <-> [Right: Hijri Date + Calendar] -->
    <LinearLayout
        android:id="@+id/widget_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center_vertical">

        <!-- Left (RTL End): City Name + Location Icon -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:gravity="left|center_vertical">

            <TextView
                android:id="@+id/widget_city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="140dp"
                android:text="مكة المكرمة"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#FFA9A59C"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_location_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginLeft="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_location"
                android:contentDescription="@string/large_widget_name" />
        </LinearLayout>

        <!-- Right (RTL Start): Hijri Date + Calendar Icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:gravity="right|center_vertical">

            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 جمادى الأولى 1448 هـ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFF4EFE6"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_calendar_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginLeft="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_calendar"
                android:contentDescription="@string/large_widget_name" />
        </LinearLayout>

    </LinearLayout>

    <!-- Section 2: Featured Hero Prayer & Next Prayer Time Left Box -->
    <LinearLayout
        android:id="@+id/widget_hero_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center_vertical"
        android:background="@drawable/widget_hero_box_dark">

        <!-- Left (RTL End): Dedicated Next Prayer Time Left Box -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:gravity="left|center_vertical">

            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:textDirection="rtl"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/widget_countdown_badge_dark"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/widget_countdown_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/widget_countdown_badge_dark"
                android:visibility="visible">

                <TextView
                    android:id="@+id/widget_countdown_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الوقت المتبقي"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFA9A59C"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:singleLine="true" />

                <Chronometer
                    android:id="@+id/widget_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:countDown="true"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFF4EFE6"
                    android:textDirection="ltr"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right (RTL Start): [Stacked Next Prayer Caption + Prayer Title] + [Prayer Icon Badge] -->
        <LinearLayout
            android:id="@+id/widget_hero_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:gravity="right|center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="right|center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layoutDirection="ltr"
                    android:gravity="right|center_vertical">

                    <TextView
                        android:id="@+id/widget_active_prayer_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:07 م"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFE3B341"
                        android:textDirection="rtl"
                        android:includeFontPadding="false"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/widget_next_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="الصلاة القادمة •"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFA9A59C"
                        android:textDirection="rtl"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_prayer_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="صلاة الظهر"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFF4EFE6"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hero_icon_box"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="8dp"
                android:gravity="center"
                android:background="@drawable/widget_countdown_badge_dark">

                <ImageView
                    android:id="@+id/widget_prayer_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_prayer_dhuhr"
                    android:contentDescription="@string/large_widget_name" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Section 3: 5 Daily Prayers Strip (RTL order: Fajr on far right -> Isha on far left) -->
    <LinearLayout
        android:id="@+id/widget_prayers_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center_vertical"
        android:weightSum="5">

        <!-- Column 1 (Far Left): Isha (العشاء) -->
        <LinearLayout
            android:id="@+id/col_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_isha"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prayer_isha"
                android:contentDescription="العشاء" />

            <TextView
                android:id="@+id/name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="العشاء"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#FFF4EFE6"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="07:05"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFF4EFE6"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Column 2 (Mid Left): Maghrib (المغرب) -->
        <LinearLayout
            android:id="@+id/col_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_maghrib"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prayer_maghrib"
                android:contentDescription="المغرب" />

            <TextView
                android:id="@+id/name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="المغرب"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#FFF4EFE6"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="05:38"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFF4EFE6"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Column 3 (Center): Asr (العصر) -->
        <LinearLayout
            android:id="@+id/col_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_asr"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prayer_asr"
                android:contentDescription="العصر" />

            <TextView
                android:id="@+id/name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="العصر"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#FFF4EFE6"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="03:11"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFF4EFE6"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Column 4 (Mid Right): Dhuhr / Jumua (الظهر) -->
        <LinearLayout
            android:id="@+id/col_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_col_active_dark">

            <ImageView
                android:id="@+id/icon_dhuhr"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prayer_dhuhr"
                android:contentDescription="الظهر" />

            <TextView
                android:id="@+id/name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="الظهر"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#FFE3B341"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_pill_dhuhr"
                android:text="12:07"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Column 5 (Far Right): Fajr (الفجر) -->
        <LinearLayout
            android:id="@+id/col_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/icon_fajr"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prayer_fajr"
                android:contentDescription="الفجر" />

            <TextView
                android:id="@+id/name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="الفجر"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#FFA9A59C"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="05:20"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFA9A59C"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
