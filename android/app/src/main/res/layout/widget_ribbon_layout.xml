<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/ribbon_widget_name" />

    <!-- Top Right Inline Row: [Icon] [صلاة الفجر] [Box: بعد 08:29:43] -->
    <LinearLayout
        android:id="@+id/widget_hero_row"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_alignTop="@id/widget_image"
        android:layout_alignRight="@id/widget_image"
        android:layout_alignEnd="@id/widget_image"
        android:layout_marginTop="9dp"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layoutDirection="rtl"
        android:textDirection="rtl"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_prayer_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:contentDescription="@string/ribbon_widget_name" />

        <TextView
            android:id="@+id/widget_prayer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="4dp"
            android:layout_marginStart="4dp"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="6dp"
            android:layout_marginStart="6dp"
            android:countDown="true"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_countdown_badge_dark"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
