<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include user Islamic settings, bookmarks, reading progress, and custom themes -->
    <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    <include domain="database" path="." />

    <!-- Exclude volatile caches, temporary downloads, and ephemeral media -->
    <exclude domain="root" path="cache" />
    <exclude domain="external" path="." />
</full-backup-content>

